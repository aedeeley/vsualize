{
  "name": "vsualize",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "An unobtrusive, audio-reactive desktop canvas.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:windows": "node scripts/windows/check-desktop-config.mjs --require-cli && tauri build --no-bundle",
    "installer": "node scripts/windows/check-desktop-config.mjs --require-cli && tauri build --bundles nsis",
    "check:desktop": "node scripts/windows/check-desktop-config.mjs --require-cli",
    "release:manifest": "node scripts/release/release-manifest.mjs",
    "brand:generate": "node scripts/branding/generate-branding.mjs",
    "test:branding": "node --test tests/branding.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://vsualize.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/aedeeley/vsualize.git"
  },
  "bugs": {
    "url": "https://github.com/aedeeley/vsualize/issues"
  }
}
