{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vsualize",
  "version": "0.3.0",
  "identifier": "app.vsualize.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vsualize",
        "width": 640,
        "height": 600,
        "minWidth": 300,
        "minHeight": 240,
        "center": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A borderless audio visualizer",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Vsualize",
    "homepage": "https://vsualize.app"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aedeeley/vsualize/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNzU0MDUzRkM4NjY1OUQKUldTZFpZYjhVMEIxZ3YwN2tkUkRSZC92RTlDVnEyMVlubjF2OEpJMXVaMVJvZmhZbmVTYXVkd3IK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
